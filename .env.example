# Public deployment configuration only. NEVER put private signing keys here.
# Configure a real arbitrator panel before enabling mint operations. There is
# no platform fee and no fee recipient.
VITE_ARBITRATOR_PANEL=[]
# Public support profile; an empty value hides optional support.
VITE_SUPPORT_NPUB=npub17cth6et9yp0ejv2gwfxzcjucek7msfpqa5pajlv8r4jkzjaxkkvqapeytq
VITE_SUPPORT_LIGHTNING_ADDRESS=crystalinfinity706645@getalby.com
VITE_PROTECTED_TRADES_ENABLED=false
# Incident pause: true stops new listings, quotes and funding but keeps
# settlement, refunds, collection and disputes working. Prefer this over
# turning protected trades off, which also blocks settlement.
VITE_NEW_TRADES_PAUSED=false
# Published pilot limits in whole rupees. Protected trading stays disabled until
# both are set; no limit is implied.
VITE_PILOT_MAX_INR_PER_TRADE=
VITE_PILOT_MAX_INR_PER_DAY=
# Normalized HTTPS mint URLs whose lost-swap-response NUT-09 restoration passed a
# controlled live test. Mints not listed must cache POST /v1/swap indefinitely.
VITE_RESTORE_VERIFIED_MINTS=[]
# Panel format: [{"name":"Panel name","pubkey":"64 lowercase hex Nostr key","escrowKeys":["66 lowercase hex compressed Cashu key", ...]}]
# Generate escrowKeys offline with: npm run arbitrator:keys -- generate <seed-file> 64
# Each trade uses one of these keys; the seed never leaves the arbitrator's offline device.
# Each operator must publish its private inbox (Nostr kind 10050).
# Blossom hosts are chosen in Recovery settings, not embedded in this file.
