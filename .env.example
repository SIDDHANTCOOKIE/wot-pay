# Public deployment configuration only. NEVER put private signing keys here.
# Configure a real panel and its fee desk before enabling mint operations.
VITE_ARBITRATOR_PANEL=[]
VITE_FEE_RECIPIENT=
VITE_PROTECTED_TRADES_ENABLED=false
# Panel format: [{"name":"Panel name","pubkey":"64 lowercase hex Nostr key","escrowKey":"66 lowercase hex compressed Cashu key"}]
# Each operator must publish its private inbox (Nostr kind 10050).
# Blossom hosts are chosen in Recovery settings, not embedded in this file.
